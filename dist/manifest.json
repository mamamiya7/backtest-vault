{
  "manifest_version": 3,
  "name": "Backtest Vault",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "version": "0.21.0",
  "description": "Save momentum backtest settings, portfolio statistics, charts and trades to a local research archive.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://zone.definedgesecurities.com/*"
      ],
      "js": [
        "core.js",
        "presentation.js",
        "intelligence.js",
        "source-layouts.js",
        "setup.js",
        "experiments.js",
        "capture.js",
        "runner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Backtest Vault"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
  }
}
